    {
      "parameters": {
        "jsCode": "const input = $json.query || $json;\n\nconst name = String(input.name || '').replace(/\\s+/g, ' ').trim();\nconst email = String(input.email || '').trim().toLowerCase();\n\nconst rawPhone = String(input.phone || '').trim();\nconst digits = rawPhone.replace(/\\D/g, '');\nlet phone = rawPhone.startsWith('+') ? `+${digits}` : digits;\n\nif (digits.length === 10 && /^[6-9]/.test(digits)) {\n  phone = `+91${digits}`;\n}\n\nconst interestedField = String(input.interested_field || '').replace(/\\s+/g, ' ').trim();\n\nconst errors = [];\n\nif (name.length < 2 || !/[A-Za-z\\u0900-\\u097F]/.test(name)) {\n  errors.push('Please provide a valid full name.');\n}\n\nif (!/^[^\\s@]+@[^\\s@]+\\.[A-Za-z]{2,}$/.test(email)) {\n  errors.push('Please provide a valid email address.');\n}\n\nif (digits.length < 10 || digits.length > 15) {\n  errors.push('Please provide a valid phone number containing 10 to 15 digits.');\n}\n\nif (interestedField.length < 2) {\n  errors.push('Please provide your interested field or course.');\n}\n\nconst now = new Date().toISOString();\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    error_message: errors.join(' '),\n\n    user_id: email || phone,\n    created_at: now,\n    updated_at: now,\n\n    name,\n    email,\n    phone,\n    phone_digits: digits,\n    interested_field: interestedField,\n\n    chat_session_id: String(input.chat_session_id || ''),\n    source: String(input.source || 'AICAMSR n8n RAG Chat'),\n    status: 'Admission Enquiry'\n  }\n}];"
      },
